# ---------- HOMEFORM AI — variables d'environnement ----------
# Sans Supabase, l'app tourne en « mode local » (données dans le navigateur, bandeau visible).

# URL publique du site (utilisée pour les redirections Stripe / Supabase)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (comptes, base de données)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé serveur UNIQUEMENT (webhook Stripe). Ne jamais préfixer par NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (abonnements)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=

# Coach IA (Claude API) — serveur uniquement
ANTHROPIC_API_KEY=
COACH_MODEL=claude-haiku-5-5

# Autorise le bouton « accès de test » en mode local (jamais en production)
NEXT_PUBLIC_ALLOW_DEV_UNLOCK=true
